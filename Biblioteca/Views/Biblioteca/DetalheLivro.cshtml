@model Livro 


<body class="fundoselo">
   <div id="container">
    <div class="card-livro">
        
        <div class="lado-esquerdo">
            <div class="img-livro"> 
    <img src="~/@Model.ImgUrl" alt="Livro">

            </div>
<div class="ci-b">
             <button><a asp-area="" asp-controller="Biblioteca" asp-action="DetalheAutor"  asp-route-id="@Model.Autor!.Id">Detalhes sobre o autor</a></button>
    <a asp-action="EditarLivro" asp-route-id="@Model.Id" class="btn-primary">Editar</a>
        </div>
        </div>

        <div class="lado-direito">
            <h1 class="titulo">@Model.Titulo</h1>

            <p><strong>Resumo:</strong>@Model.Resumo</p>

            <p><strong>Ano de publicação:</strong> @Model.DataPublicacao</p>
            <p><strong>Autor:</strong> @Model.Autor.Nome</p>
        </div>

    </div>
</div>
    </div>
</body>