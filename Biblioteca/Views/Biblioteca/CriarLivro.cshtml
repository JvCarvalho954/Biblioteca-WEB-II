@model Biblioteca.Models.CriarLivroViewModel;
<body>
    <form method="post" asp-action="CriarLivro" asp-controller="Biblioteca">
        <label>Cadastrar um livro:</label>
        <label>Título:</label>
        <input name="Titulo"/>
        <label>Autor:</label>
        <select name="AutorId" class="form-control" asp-items="@ViewBag.Autores"></select>
        <label>Genero:</label>
        <input name="Genero"/>
        <label>Ano de publicação:</label>
        <input name="DataPublicacao" type="date"/>
        <label>Resumo:</label>
        <input name="Resumo"/>
        <label>Descrição:</label>
        <input name="Descricao"/>
        <label>URL da Imagem:</label>
        <input name="ImgUrl"/>
        <label>Numero de páginas:</label>
        <input name="NumPaginas"/>
        <label>Destaque?</label>
        <input name="Destaque" type="checkbox"/>
        <input type="submit" value="Cadastrar">
    </form>
</body>
