<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LogLivro</title>
</head>
<body>
    <form method="post" asp-action="CriarLivro" asp-controller="Biblioteca">
        <label>Cadastrar um livro:</label>
        <label>Título:</label>
        <input name="Titulo"/>
        <label>Autor:</label>
        <input name="Autor"/>
        <label>Genero:</label>
        <input name="Genero"/>
        <label>Ano de publicação:</label>
        <input name="DataPublicacao" type="date"/>
        <label>Resumo:</label>
        <input name="Resumo"/>
        <label>Descrição:</label>
        <input name="Descricao"/>
        <label>URL da Imagem:</label>
        <input name="ImgUrl"/>
        <label>Numero de páginas:</label>
        <input name="NumPaginas"/>
        <input type="submit" value="Cadastrar">
    </form>
</body>
</html>