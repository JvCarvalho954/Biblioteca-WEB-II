
<form method="post" asp-action="CriarAutor" asp-controller="Biblioteca">
    <label>Cadastrar um Autor:</label>
    <label>Nome:</label>
    <input name="Nome"/>
    <label>Data de nascimento:</label>
    <input name="Nascimento" type="date"/>
    <label>Data de falecimento:</label>
    <input name="Falecimento" type="date"/>
    <label>Local de nascimento:</label>
    <input name="LocalNatal"/>
    <label>Descrição:</label>
    <input name="Descricao"/>
    <label>URL da Imagem:</label>
    <input name="ImgUrl"/>
    <label>Obras:</label>
    <input name="Obras"/>
    <input type="submit" value="Cadastrar">
</form>
